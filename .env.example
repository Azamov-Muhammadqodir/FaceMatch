# Copy to .env and adjust. Every value has a default in docker-compose.yml.
POSTGRES_DB=facematch
POSTGRES_USER=facematch
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-too
MINIO_BUCKET=facematch
API_PORT=8080
PROCESSING_PARALLELISM=2
MIN_SIMILARITY=0.4

# If Docker Hub rate-limits you, pull the Go/Alpine build images from a mirror:
# GO_IMAGE=mirror.gcr.io/library/golang:1.24-alpine
# ALPINE_IMAGE=mirror.gcr.io/library/alpine:3.22
